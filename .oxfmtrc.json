{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "trailingComma": "es5",
  "sortPackageJson": false,
  "ignorePatterns": [
    "dist",
    "node_modules",
    "rust-profiler",
    "coverage",
    "build",
    "report.html",
    "results*.json",
    "tasks",
    "**/embedded.generated.ts"
  ]
}
